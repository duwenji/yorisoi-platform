{
  "$comment": "ADR-AGENT A-11・A-12・A-15・A-45。準備役が頼む道具の定義。中継はこの写しを持ち、アプリからは版と道具の名前だけを受ける。先に取る道具（calendar・weather・season_obs・local_events）は準備役に頼ませないので、ここには置かない。",
  "version": 1,
  "tools": [
    {
      "name": "read_page",
      "description": "出どころの番号（P1 など）か、前に読んだページのリンクの番号（L1 など）のページを読み、手がかりと、たどれるリンクを返す。一度に 5 つまで。",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ids"],
        "properties": {
          "ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "items": { "type": "string", "pattern": "^[PL][0-9]{1,3}$" }
          }
        }
      }
    },
    {
      "name": "nearby_spots",
      "description": "周り 1 km と前方のスポットを返す。名前・種類・地図データと Wikidata の情報・距離（100 m 単位）・向き（8 方位）。座標は返さない。",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "ahead": { "type": "boolean", "description": "前方のスポットだけにするなら true" }
        }
      }
    },
    {
      "name": "materials",
      "description": "スポットの番号（S1 など）か話題についての、素材と参考の文章を返す。",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "spot": { "type": "string", "pattern": "^S[0-9]{1,3}$" },
          "topic": { "type": "string", "maxLength": 20 }
        }
      }
    },
    {
      "name": "submit_threads",
      "description": "話の筋を提出する。事実の文は書かず、使う道具の結果の番号（R1 など）だけを指す。話題とつなぎには事実・数字・固有の名前を書かない。",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["threads"],
        "properties": {
          "threads": {
            "type": "array",
            "maxItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "steps"],
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "^(calendar|season|livelihood|events)(>(calendar|season|livelihood|events)){1,3}$",
                  "description": "場面を > でつないだ型。例: calendar>season>livelihood"
                },
                "steps": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 4,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["topic", "refs", "bridge"],
                    "properties": {
                      "topic": { "type": "string", "maxLength": 20 },
                      "refs": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 3,
                        "items": { "type": "string", "pattern": "^R[0-9]{1,3}$" }
                      },
                      "bridge": { "type": "string", "maxLength": 30, "description": "前の段からのつなぎの言葉。事実・数字を書かない" }
                    }
                  }
                }
              }
            }
          },
          "spot": {
            "type": "object",
            "additionalProperties": false,
            "description": "スポットの準備のときだけ。段 1 つ（A-3）",
            "required": ["spot", "refs"],
            "properties": {
              "spot": { "type": "string", "pattern": "^S[0-9]{1,3}$" },
              "refs": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "type": "string", "pattern": "^R[0-9]{1,3}$" } }
            }
          }
        }
      }
    }
  ]
}
