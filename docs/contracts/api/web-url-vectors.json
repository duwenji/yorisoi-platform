{
  "$comment": "AGENT A-17・A-24・A-26。読んでよい URL の判定の見本。from は、たどった元の出どころの URL（null は台帳・チャンネルの出どころそのもの）。depth は出どころから何回たどったか。core-web とタイルのバッチ（読むページの候補の絞り込み）が同じ判定をする。",
  "version": 1,
  "exclusion": {
    "version": 3,
    "entries": [
      { "match": { "domain": "matome.example.com" }, "kind": "aggregator" },
      { "match": { "prefix": "https://www.city.fukui.lg.jp/kurashi/nyusatsu/" }, "kind": "unsuitable-page" }
    ]
  },
  "cases": [
    { "url": "https://www.city.fukui.lg.jp/news/", "from": null, "depth": 0, "inLedger": true, "allow": true },
    { "url": "https://www.city.fukui.lg.jp/kankou/event/2026/11.html", "from": "https://www.city.fukui.lg.jp/news/", "depth": 1, "allow": true },
    { "url": "https://www.city.fukui.lg.jp/kankou/event/2026/11/a.html", "from": "https://www.city.fukui.lg.jp/news/", "depth": 3, "allow": false, "reason": "too-deep" },
    { "url": "https://www.city.fukui.lg.jp/kurashi/nyusatsu/2026.html", "from": "https://www.city.fukui.lg.jp/news/", "depth": 1, "allow": false, "reason": "excluded-prefix" },
    { "url": "https://www.pref.fukui.lg.jp/doc/a.html", "from": "https://www.city.fukui.lg.jp/news/", "depth": 1, "allow": false, "reason": "other-site" },
    { "url": "https://kanko.city.fukui.lg.jp/event.html", "from": "https://www.city.fukui.lg.jp/news/", "depth": 1, "allow": true, "note": "登録できるドメイン city.fukui.lg.jp が同じ" },
    { "url": "https://sub.matome.example.com/x", "from": null, "depth": 0, "inLedger": true, "allow": false, "reason": "excluded-domain" },
