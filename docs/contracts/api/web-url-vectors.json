    { "url": "https://kankou-a.hatenablog.com/shop/", "from": "https://kankou-a.hatenablog.com/news/", "depth": 1, "allow": false, "reason": "outside-source-path", "note": "共用のサービスの上の出どころは、出どころのパスの下に限る" },
    { "url": "http://www.city.example.lg.jp/news/", "from": null, "depth": 0, "inLedger": true, "allow": true, "note": "台帳に http で載っている行は http のまま読む" },
    { "url": "https://www.city.fukui.lg.jp/news/", "from": null, "depth": 0, "inLedger": true, "exclusionNeverFetched": true, "allow": true, "note": "除外リストが一度も取れていなくても、台帳の URL は読む" },
    { "url": "https://www.city.fukui.lg.jp/kankou/event/2026/11.html", "from": "https://www.city.fukui.lg.jp/news/", "depth": 1, "exclusionNeverFetched": true, "allow": false, "reason": "no-exclusion-list" },
    { "url": "https://kankou-a.hatenablog.com/news/", "from": null, "depth": 0, "inChannel": true, "exclusionNeverFetched": true, "allow": false, "reason": "no-exclusion-list" },
