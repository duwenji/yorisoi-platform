{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/duwenji/yorisoi-platform/docs/api/spot-tile.schema.json",
  "title": "yorisoi spot tile (API-SPOT-TILES v1)",
  "type": "object",
  "required": ["format", "version", "layer", "tile", "osmTimestamp", "generatedAt", "license", "attribution"],
  "properties": {
    "format": { "const": "yorisoi-spot-tile" },
    "version": { "const": 1 },
    "layer": { "enum": ["base", "shops", "events"] },
    "tile": { "type": "string", "pattern": "^[0-9b-hjkmnp-z]{5}$" },
    "osmTimestamp": { "type": "string", "format": "date-time" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "license": { "const": "ODbL-1.0" },
    "attribution": { "const": "© OpenStreetMap contributors" },
    "spots": { "type": "array", "items": { "$ref": "#/$defs/element" } },
    "facilities": { "type": "array", "items": { "$ref": "#/$defs/facility" } },
    "signals": { "$ref": "#/$defs/coords" },
    "shops": { "type": "array", "items": { "$ref": "#/$defs/shop" } },
    "eventsFrom": { "$ref": "#/$defs/date" },
    "eventsUntil": { "$ref": "#/$defs/date" },
    "events": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/event" } }
  },
  "allOf": [
    {
      "if": { "properties": { "layer": { "const": "base" } } },
      "then": { "required": ["spots", "facilities", "signals"], "not": { "anyOf": [{ "required": ["shops"] }, { "required": ["events"] }, { "required": ["eventsFrom"] }, { "required": ["eventsUntil"] }] } }
    },
    {
      "if": { "properties": { "layer": { "const": "shops" } } },
      "then": { "required": ["shops"], "not": { "anyOf": [{ "required": ["spots"] }, { "required": ["facilities"] }, { "required": ["signals"] }, { "required": ["events"] }, { "required": ["eventsFrom"] }, { "required": ["eventsUntil"] }] } }
    },
    {
      "if": { "properties": { "layer": { "const": "events" } } },
      "then": { "required": ["eventsFrom", "eventsUntil", "events"], "not": { "anyOf": [{ "required": ["spots"] }, { "required": ["facilities"] }, { "required": ["signals"] }, { "required": ["shops"] }] } }
    }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^(node|way|relation)/[1-9][0-9]*$" },
    "lat": { "type": "number", "minimum": -90, "maximum": 90 },
    "lon": { "type": "number", "minimum": -180, "maximum": 180 },
    "coords": { "type": "array", "items": { "type": "number" } },
    "tags": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": { "type": "string" }
    },
    "element": {
      "type": "object",
      "required": ["id", "lat", "lon", "tags"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "lat": { "$ref": "#/$defs/lat" },
        "lon": { "$ref": "#/$defs/lon" },
        "tags": { "$ref": "#/$defs/tags" },
        "wikidata": { "$ref": "#/$defs/wikidata" },
        "shape": {
          "type": "object",
          "required": ["area", "lines"],
          "properties": {
            "area": { "type": "boolean" },
            "lines": { "type": "array", "minItems": 1, "items": { "allOf": [{ "$ref": "#/$defs/coords" }, { "minItems": 4 }] } }
          }
        }
      }
    },
    "shop": {
      "allOf": [{ "$ref": "#/$defs/element" }, { "not": { "anyOf": [{ "required": ["shape"] }, { "required": ["wikidata"] }] } }]
    },
    "text": { "type": "string", "minLength": 1 },
    "texts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/text" } },
    "wikidata": {
      "type": "object",
      "required": ["id"],
      "minProperties": 2,
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^Q[1-9][0-9]*$" },
        "description": { "$ref": "#/$defs/text" },
        "reading": { "$ref": "#/$defs/text" },
        "kinds": { "allOf": [{ "$ref": "#/$defs/texts" }, { "maxItems": 3 }] },
        "inception": { "type": "string", "pattern": "^([0-9]{1,4}(-[0-9]{2}(-[0-9]{2})?)?|C[1-9][0-9]?|[0-9]{1,3}0年代)$" },
        "heritage": { "$ref": "#/$defs/texts" },
        "architects": { "$ref": "#/$defs/texts" },
        "founders": { "$ref": "#/$defs/texts" },
        "jawiki": { "$ref": "#/$defs/text" },
        "image": { "$ref": "#/$defs/text" },
        "website": { "type": "string", "pattern": "^https?://" }
      }
    },
    "date": { "type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$" },
    "time": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
    "url": { "type": "string", "pattern": "^https?://" },
    "event": {
      "type": "object",
      "required": ["id", "name", "startDate", "endDate", "venue", "lat", "lon", "precision", "source"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[0-9]{6}:(h:[0-9a-f]{16}|[^:]+)$" },
        "name": { "$ref": "#/$defs/text" },
        "startDate": { "$ref": "#/$defs/date" },
        "endDate": { "$ref": "#/$defs/date" },
        "startTime": { "$ref": "#/$defs/time" },
        "endTime": { "$ref": "#/$defs/time" },
        "venue": { "$ref": "#/$defs/text" },
        "lat": { "$ref": "#/$defs/lat" },
        "lon": { "$ref": "#/$defs/lon" },
        "precision": { "enum": ["point", "area"] },
        "area": { "$ref": "#/$defs/text" },
        "summary": { "allOf": [{ "$ref": "#/$defs/text" }, { "maxLength": 120 }] },
        "conditions": { "allOf": [{ "$ref": "#/$defs/text" }, { "maxLength": 80 }] },
        "url": { "$ref": "#/$defs/url" },
        "source": {
          "type": "object",
          "required": ["publisher", "dataset", "license"],
          "additionalProperties": false,
          "properties": {
            "publisher": { "$ref": "#/$defs/text" },
            "dataset": { "$ref": "#/$defs/url" },
            "license": { "$ref": "#/$defs/text" }
          }
        }
      },
      "if": { "properties": { "precision": { "const": "area" } } },
      "then": { "required": ["area"] }
    },
    "facility": {
      "type": "object",
      "required": ["id", "kind", "lat", "lon"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "type": "string", "pattern": "^[A-Z][A-Z_]*$" },
        "lat": { "$ref": "#/$defs/lat" },
        "lon": { "$ref": "#/$defs/lon" },
        "name": { "type": "string" },
        "publicTransport": { "const": true }
      }
    }
  }
}
