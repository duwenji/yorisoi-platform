{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "season-obs.schema.json",
  "title": "季節の観測（寒候年ごとの配信ファイル）",
  "$comment": "AGENT A-27・A-28。タイルのバッチが気象庁防災情報 XML（VGSK50・VGSK55）と「初冠雪の記録等」から作る。観測の値は変えない。",
  "type": "object",
  "additionalProperties": false,
  "required": ["season", "generatedAt", "attribution", "observations"],
  "properties": {
    "season": { "type": "string", "pattern": "^[0-9]{4}$", "description": "寒候年（前年 8 月〜その年 7 月）。例: 2027 は 2026 年 8 月〜2027 年 7 月" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "attribution": { "type": "string", "description": "例: 出典：気象庁ホームページ（防災情報 XML「季節観測」「生物季節観測」）を加工して作成" },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "date", "place", "prefecture"],
        "properties": {
          "kind": { "enum": ["first-snow", "first-frost", "first-ice", "phenology", "snow-cap"] },
          "name": { "type": "string", "maxLength": 20, "description": "生物季節観測の種目（例: かえでの紅葉日）。初冠雪は山の名前" },
          "date": { "type": "string", "format": "date" },
          "place": { "type": "string", "maxLength": 30, "description": "観測した気象台・観測所、または山" },
          "prefecture": { "type": "string", "pattern": "^[0-4][0-9]$" },
          "municipality": { "type": "string", "pattern": "^[0-9]{6}$", "description": "観測所の所在地の団体コード。山は書かない" },
          "fromNormal": { "type": ["integer", "null"], "description": "平年差（日）。早いと負" },
          "fromLastYear": { "type": ["integer", "null"], "description": "昨年差（日）" },
          "source": { "type": "string", "pattern": "^https://", "description": "元の電文かページの URL" }
        }
      }
    }
  }
}
