{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/duwenji/yorisoi-platform/docs/api/spot-tile.schema.json",
  "title": "yorisoi spot tile (API-SPOT-TILES v1)",
  "type": "object",
  "required": ["format", "version", "layer", "tile", "osmTimestamp", "generatedAt", "license", "attribution"],
  "properties": {
    "format": { "const": "yorisoi-spot-tile" },
    "version": { "const": 1 },
    "layer": { "enum": ["base", "shops"] },
    "tile": { "type": "string", "pattern": "^[0-9b-hjkmnp-z]{5}$" },
    "osmTimestamp": { "type": "string", "format": "date-time" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "license": { "const": "ODbL-1.0" },
    "attribution": { "const": "© OpenStreetMap contributors" },
    "spots": { "type": "array", "items": { "$ref": "#/$defs/element" } },
    "facilities": { "type": "array", "items": { "$ref": "#/$defs/facility" } },
    "signals": { "$ref": "#/$defs/coords" },
    "shops": { "type": "array", "items": { "$ref": "#/$defs/shop" } }
  },
  "allOf": [
    {
      "if": { "properties": { "layer": { "const": "base" } } },
      "then": { "required": ["spots", "facilities", "signals"], "not": { "required": ["shops"] } }
    },
    {
      "if": { "properties": { "layer": { "const": "shops" } } },
      "then": { "required": ["shops"], "not": { "anyOf": [{ "required": ["spots"] }, { "required": ["facilities"] }, { "required": ["signals"] }] } }
    }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^(node|way|relation)/[1-9][0-9]*$" },
    "lat": { "type": "number", "minimum": -90, "maximum": 90 },
    "lon": { "type": "number", "minimum": -180, "maximum": 180 },
    "coords": { "type": "array", "items": { "type": "number" } },
    "tags": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": { "type": "string" }
    },
    "element": {
      "type": "object",
      "required": ["id", "lat", "lon", "tags"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "lat": { "$ref": "#/$defs/lat" },
        "lon": { "$ref": "#/$defs/lon" },
        "tags": { "$ref": "#/$defs/tags" },
        "shape": {
          "type": "object",
          "required": ["area", "lines"],
          "properties": {
            "area": { "type": "boolean" },
            "lines": { "type": "array", "minItems": 1, "items": { "allOf": [{ "$ref": "#/$defs/coords" }, { "minItems": 4 }] } }
          }
        }
      }
    },
    "shop": {
      "allOf": [{ "$ref": "#/$defs/element" }, { "not": { "required": ["shape"] } }]
    },
    "facility": {
      "type": "object",
      "required": ["id", "kind", "lat", "lon"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "type": "string", "pattern": "^[A-Z][A-Z_]*$" },
        "lat": { "$ref": "#/$defs/lat" },
        "lon": { "$ref": "#/$defs/lon" },
        "name": { "type": "string" },
        "publicTransport": { "const": true }
      }
    }
  }
}
